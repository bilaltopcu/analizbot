# Telegram AI Code Editor Bot – Ortam Değişkenleri
# Bu dosyayı doldurup .env olarak kaydet (asla Git'e ekleme!)

# ── Telegram ──────────────────────────────────────────────────────────
# BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Sadece bu Chat ID'den gelen mesajlar kabul edilir
# Kendi ID'ni öğrenmek için @userinfobot'a /start yaz
ALLOWED_CHAT_ID=987654321

# ── Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# (Opsiyonel) Varsayılan: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ── GitHub ────────────────────────────────────────────────────────────
# Fine-grained PAT: Contents (read+write) yetkisi yeterli
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "kullanici/repo-adi" formatında
GITHUB_REPO=bilaltopcu/analizbot

# (Opsiyonel) Varsayılan: master
# GITHUB_BRANCH=master

# ── Bot Davranışı ─────────────────────────────────────────────────────
# true → Onay butonu beklemeden otomatik commit yap
# false → Diff önizleme + Onayla/Reddet butonu göster (önerilen)
AUTO_APPROVE=false

# (Opsiyonel) Gemini'ye gönderilecek max karakter limiti
# MAX_CONTEXT_CHARS=120000
